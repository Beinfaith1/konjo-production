# Resend (https://resend.com) — create an API key and verify a sending domain
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Sender on a domain verified in Resend, e.g. "Konjo Website <inquiries@yourdomain.com>". Do NOT use a gmail.com address.
RESEND_FROM="Konjo Website <inquiries@your-verified-domain.com>"
# Where inquiries are delivered (defaults to konjoproduction@gmail.com)
INQUIRY_TO=konjoproduction@gmail.com
